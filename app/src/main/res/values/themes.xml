<resources>
    <style name="Theme.Appareillage" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/brand</item>
    </style>

    <style name="Theme.Appareillage.Fullscreen" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_dark</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="Card" parent="Widget.Material3.CardView.Elevated">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <style name="CardTitle" parent="TextAppearance.Material3.TitleLarge" />
</resources>
